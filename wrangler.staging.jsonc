{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 模板自身的 workers.dev 预发环境：真实 Cloudflare 资源 + 支付商 test 模式，用来在没有域名时验证线上行为。
  // 构建：npx vite build --mode staging；其余 wrangler 命令加 -c wrangler.staging.jsonc。用法见 README“模板预发”。
  // 绑定名、vars 键和运行参数必须与 wrangler.jsonc 一致，资源名必须带 -staging（tests/unit/staging.test.ts 检查）。
  // new-site 会删除本文件。
  "name": "video-template-staging",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // staging 按生产行为运行（禁用 mock 和开发登录），但 robots.txt 禁止抓取
    "APP_ENV": "staging",
    // 部署前把 SUBDOMAIN 换成账号的 workers.dev 子域名（Dashboard → Workers & Pages 右侧可见）
    "SITE_URL": "https://video-template-staging.SUBDOMAIN.workers.dev",
    "PAYMENT_PROVIDER": "waffo",
    "VIDEO_PROVIDER": "fal",
    "ADMIN_EMAILS": "admin@example.com",
    // 没有可 Onboard 的域名，staging 不发信（后台“邮件”页记为 skipped）
    "EMAIL_FROM": "",
    "WAFFO_ENVIRONMENT": "test",
    // Waffo 店铺 ID（STO_xxx，公开）：订阅的客户门户要用；只卖积分包可以留空
    "WAFFO_STORE_ID": "",
    "DODO_ENVIRONMENT": "test",
    // test 店铺的商品 id，与 .dev.vars 中的值相同
    "WAFFO_PRODUCTS": "{}",
    "DODO_PRODUCTS": "{}",
    // Stripe：test | live，要和 STRIPE_SECRET_KEY 的模式一致；STRIPE_PRODUCTS 存 Price ID（price_...），scripts/stripe-setup.mjs 可以生成
    "STRIPE_ENVIRONMENT": "test",
    "STRIPE_PRODUCTS": "{}",
    "GOOGLE_CLIENT_ID": "",
    "TURNSTILE_SITE_KEY": "",
    // Umami 实例地址（不带路径的 https origin，如 https://umami.example.com）；留空 = 不代理。只在 Worker 端使用，不进前端
    "UMAMI_ORIGIN": "",
    // 有 OPENAI_API_KEY 后改为 openai
    "MODERATION_PROVIDER": "none",
    // 成片输出审核：frames | off。frames 需要 "media": { "binding": "MEDIA_TRANSFORM" } 绑定，见 wrangler.jsonc 的说明
    "OUTPUT_MODERATION": "off"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-template-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "video-template-staging-media" }],
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
  "queues": {
    "producers": [{ "binding": "VIDEO_QUEUE", "queue": "video-template-staging-jobs" }],
    "consumers": [
      {
        "queue": "video-template-staging-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "video-template-staging-jobs-dlq"
      },
      { "queue": "video-template-staging-jobs-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "58111", "simple": { "limit": 20, "period": 60 } },
    { "name": "GENERATE_LIMITER", "namespace_id": "58112", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "58113", "simple": { "limit": 30, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
